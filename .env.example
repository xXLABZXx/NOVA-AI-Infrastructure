# NOVA AI Infrastructure - environment template
# Copy to .env and fill in. NEVER commit a filled .env to git.
# The .env file is gitignored; CI and production should use GitHub Secrets / a secret manager.

# --- Teacher model (DeepSeek or OpenAI-compatible) ---
# Leave empty to run the teacher in disabled/graceful mode.
DEEPSEEK_API_KEY=
TEACHER_BASE_URL=https://api.deepseek.com
TEACHER_MODEL=deepseek-chat

# --- General ---
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO

# --- Module toggles (override configs/config.yaml) ---
# NOVA_MODULES_SANDBOX=true
# NOVA_MODULES_TEACHER=false

# --- Sandbox overrides ---
# NOVA_SANDBOX_MAX_DOWNLOAD_BYTES=5242880
# NOVA_SANDBOX_REQUESTS_PER_MINUTE=30
